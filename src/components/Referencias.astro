---
import referencias from '../data/referencias.json';
import listaCompleta from '../assets/Referencias.docx?url';

// Se muestran las primeras; la lista completa se descarga de src/assets/Referencias.docx.
const destacadas = referencias.slice(0, 6).map((texto) => {
	const url = texto.match(/https?:\/\/\S+/)?.[0];
	return {
		texto: (url ? texto.replace(url, '') : texto).trim(),
		url,
		anio: texto.match(/\((\d{4})\)/)?.[1],
	};
});
---

<section id="referencias" class="scroll-mt-20 bg-white py-[68px]">
	<div class="reveal mx-auto max-w-[1200px] px-6">
	<!-- 	<div class="flex flex-wrap items-center gap-2.5">
			<span class="rounded-full bg-mist px-3 py-1.5 text-[12px] font-bold uppercase tracking-[0.1em] text-[#0b625f]">
				Estación 6 · Bitácora
			</span>
			<span class="rounded-full bg-navy px-3 py-1.5 text-[12px] font-bold text-white">Bibliografía</span>
		</div> -->
		<h2 class="mt-3 font-display text-[40px] font-bold leading-tight text-navy">7. Referencias</h2>
		<p class="mt-3 max-w-[760px] text-[18px] leading-8 text-navy/80">
			Las fuentes que sostienen la revisión, en formato APA. Aquí algunas; la lista completa se descarga en Word.
		</p>

		<ol class="mt-10 grid gap-3 md:grid-cols-2">
			{destacadas.map((r, i) => (
				<li class="flex flex-col rounded-2xl border border-[#d3e3e1] bg-white p-5 transition hover:border-teal-mid hover:shadow-md">
					<div class="flex items-center gap-2.5 text-[11.5px] font-bold">
						<span class="grid size-6 place-items-center rounded-full bg-mist text-[#0b625f]">{i + 1}</span>
						{r.anio && <span class="uppercase tracking-[0.1em] text-[#a86a00]">{r.anio}</span>}
					</div>
					<p class="mt-3 flex-1 text-[13.5px] leading-6 text-navy/85">{r.texto}</p>
					{r.url && (
						<a
							href={r.url}
							target="_blank"
							rel="noopener"
							class="mt-3 inline-flex w-fit items-center gap-1 text-[12.5px] font-bold text-[#0b625f] hover:underline"
						>
							Ver fuente
							<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"></path></svg>
						</a>
					)}
				</li>
			))}
		</ol>

		<div class="mt-6 flex flex-col items-start gap-4 rounded-2xl bg-navy px-6 py-5 text-white md:flex-row md:items-center md:justify-between">
			<div>
				<p class="font-display text-[17px] font-semibold leading-tight">Lista completa en formato APA 7</p>
				<p class="mt-1 text-[13px] text-teal-soft">Documento Word con todas las referencias de la revisión</p>
			</div>
			<a href={listaCompleta} download="Referencias.docx" class="inline-flex shrink-0 items-center gap-2 rounded-full bg-amber px-5 py-2.5 text-[13px] font-bold text-navy hover:brightness-105">
				<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11m0 0-4-4m4 4 4-4M5 20h14"></path></svg>
				Descargar en Word
			</a>
		</div>
	</div>
</section>
