---
// Posiciones (px) relativas al lienzo de 900 × 398 en escritorio.
const branches = [
	{ title: 'Acceso e infraestructura', refs: 'Cruz et al. (2020) · Muñoz et al. (2025)', side: 'left', top: 49 },
	{ title: 'Apropiación pedagógica (TAC)', refs: 'Ávila (2024) · Ofosu (2024)', side: 'left', top: 163 },
	{ title: 'Mitigación: móvil y offline', refs: 'Uribe et al. (2023) · Ferrín et al. (2025)', side: 'left', top: 277 },
	{ title: 'Empoderamiento (TEP)', refs: 'Mulford et al. (2022) · Yung et al. (2024)', side: 'right', top: 49 },
	{ title: 'Marco conceptual', refs: 'Cabero (2015) · Mayorga (2020)', side: 'right', top: 163 },
	{ title: 'Política y contexto', refs: 'PDDC (2024) · UNESCO, UNICEF y CEPAL (2022)', side: 'right', top: 277, warm: true },
];
---

<section id="referencias" class="scroll-mt-20 bg-[#fff6f2] py-[68px]">
	<div class="mx-auto max-w-[900px] px-6 lg:max-w-[1200px]">
		<div class="lg:mx-auto lg:max-w-[900px]">
			<div class="flex flex-wrap items-center gap-2.5">
				<span class="rounded-full bg-mist px-3 py-1.5 text-[12px] font-bold uppercase tracking-[0.1em] text-[#a3154f]">
					Estación 6 · Bitácora
				</span>
				<span class="rounded-full bg-navy px-3 py-1.5 text-[12px] font-bold text-white">Mapa mental</span>
			</div>
			<h2 class="mt-3 font-display text-[40px] font-bold leading-tight text-navy">7. Referencias</h2>
			<p class="mt-3 max-w-[600px] text-[16px] leading-7 text-navy/80">
				Las fuentes organizadas por rama temática. Cada rama abre su lista de referencias en formato APA.
			</p>

			<div class="mt-12 rounded-[28px] border border-[#f0d3da] bg-white p-6 lg:relative lg:h-[398px] lg:p-0">
				<svg class="absolute inset-0 hidden h-full w-full lg:block" viewBox="0 0 900 398" fill="none" stroke="#f7a6c4" stroke-width="2" aria-hidden="true">
					<path d="M288 85H324V313H288M324 199H360"></path>
					<path d="M612 85H576V313H612M576 199H540"></path>
				</svg>

				<div class="flex flex-col gap-3 lg:contents">
					{branches.map((b) => (
						<a
							href="#"
							style={`--t:${b.top}px`}
							class={`block w-full rounded-xl border px-3 py-3 transition hover:shadow-md lg:absolute lg:top-[var(--t)] lg:h-[72px] lg:w-[180px] ${b.side === 'left' ? 'lg:left-[108px]' : 'lg:left-[612px]'} ${
								b.warm
									? 'border-[#f09a4a] bg-[#fff0e0]'
									: b.side === 'left'
										? 'border-teal-mid bg-[#fff6f2]'
										: 'border-[#a3154f] bg-[#fff6f2]'
							}`}
						>
							<span class="block font-display text-[13px] font-semibold leading-[18px] text-navy">{b.title}</span>
							<span class="mt-1 block text-[10.5px] leading-4 text-navy/70">{b.refs}</span>
						</a>
					))}

					<div class="order-first rounded-2xl bg-navy px-4 py-5 text-center text-white lg:absolute lg:left-[360px] lg:top-[157px] lg:order-none lg:h-[84px] lg:w-[180px]">
						<p class="font-display text-[17px] font-bold">47 estudios</p>
						<p class="mt-1 text-[12px] text-teal-soft">TIC · TAC · TEP en la ruralidad</p>
					</div>
				</div>
			</div>

			<div class="mt-8 flex flex-wrap justify-center gap-3">
				<a href="#" class="rounded-full bg-[#a3154f] px-5 py-3 text-[13px] font-bold text-white hover:brightness-110">Ver lista completa (APA 7)</a>
				<a href="#" target="_blank" rel="noopener" class="rounded-full border border-teal-soft px-5 py-3 text-[13px] font-bold text-navy hover:bg-mist">Abrir el mapa mental interactivo</a>
			</div>
		</div>
	</div>
</section>
