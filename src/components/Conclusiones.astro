---
// Enlace de Canva (el de edición); se convierte al de visualización incrustable.
const canvaUrl = 'https://www.canva.com/design/DAHYfL2OYqw/OLLXmFqJE8CcTkxzRXRvKQ/edit';
const canvaEmbed = canvaUrl.replace(/\/(edit|view).*$/, '/view?embed');

const stats = [
	{ value: '3 de 47', text: 'estudios abordan la tríada completa TIC-TAC-TEP', box: 'bg-navy text-white', num: 'text-amber' },
	{ value: '34 % · 70 %', text: 'conectividad rural frente a urbana en Cundinamarca', box: 'bg-deep text-white', num: 'text-amber' },
	{ value: '0', text: 'metas educativas del PDDC con enfoque de empoderamiento (TEP)', box: 'bg-mist text-navy', num: 'text-navy' },
];

const retos = [
	{ b: 'Estructurales:', t: 'conectividad, energía, equipos y soporte técnico.' },
	{ b: 'De gobernanza:', t: 'sectores fragmentados y vacío normativo.' },
	{ b: 'Conceptuales:', t: 'metas de cobertura, sin apropiación ni participación.' },
];

const oportunidades = [
	{ b: 'Formación docente', t: 'situada y con acompañamiento en el aula.' },
	{ b: 'Aprendizaje móvil y recursos offline', t: 'como senderos alternos.' },
	{ b: 'Un plan que ya reconoce', t: 'la brecha y tiene metas medibles.' },
];

const ruta = [
	{ n: 1, label: 'Diagnosticar', bg: 'var(--color-teal-soft)', fg: 'var(--color-navy)' },
	{ n: 2, label: 'Formar', bg: 'var(--color-teal-mid)', fg: 'var(--color-navy)' },
	{ n: 3, label: 'Adaptar', bg: 'var(--color-teal-deep)', fg: 'var(--color-navy)' },
	{ n: 4, label: 'Participar', bg: 'var(--color-deep)', fg: '#ffffff' },
	{ n: 5, label: 'Evaluar', bg: 'var(--color-navy)', fg: '#ffffff' },
];
---

<section id="conclusiones" class="scroll-mt-20 bg-tint py-[72px]">
	<div class="reveal mx-auto max-w-[1200px] px-6">
		<div>
			<div class="flex flex-wrap items-center gap-2.5">
				<!-- <span class="rounded-full bg-mist px-3 py-1.5 text-[12px] font-bold uppercase tracking-[0.1em] text-deep">
					Estación 5 · Cumbre
				</span>
				<span class="rounded-full bg-navy px-3 py-1.5 text-[12px] font-bold text-white">Presentación Canva</span> -->
			</div>
			<h2 class="mt-3 font-display text-[40px] font-bold leading-tight text-navy">6. Conclusiones</h2>
		<span class="mt-4 block h-1.5 w-20 rounded-full bg-gradient-to-r from-amber to-teal-mid" aria-hidden="true"></span>
			<p class="mt-3 max-w-[760px] text-[18px] leading-8 text-navy/80">
				La ruta de ascenso en una presentación y una infografía para consultar y compartir.
			</p>

			<div class="mt-12 rounded-[24px] bg-deep p-4 md:p-6">
				<h3 class="font-display text-[23px] font-bold leading-tight text-white">Del acceso a la comunidad a la cumbre</h3>
				<p class="mt-2 text-[12.5px] text-white/90">Presentación interactiva · Usa las flechas para avanzar</p>
				<div class="mt-5 aspect-video overflow-hidden rounded-xl bg-white">
					<iframe
						title="Presentación de conclusiones en Canva"
						src={canvaEmbed}
						class="size-full border-0"
						allow="fullscreen"
						allowfullscreen
						loading="lazy"
					></iframe>
				</div>
				<p class="mt-4 text-right text-[12.5px] font-semibold text-white underline underline-offset-2">
					<a href={canvaEmbed.replace('?embed', '')} target="_blank" rel="noopener">Abrir en Canva</a>
				</p>
			</div>

			<div id="infografia" class="mt-8 rounded-[28px] border border-line bg-white p-8 md:p-[30px]">
				<h3 class="text-center font-display text-[23px] font-bold text-navy">Del acceso a la comunidad: retos, oportunidades y ruta</h3>

				<div class="mt-6 grid gap-3 md:grid-cols-3">
					{stats.map((s) => (
						<div class={`rounded-[18px] px-[18px] py-5 ${s.box}`}>
							<p class={`font-display text-[32px] font-bold leading-none ${s.num}`}>{s.value}</p>
							<p class="mt-3 text-[12.5px] leading-[18px]">{s.text}</p>
						</div>
					))}
				</div>

				<div class="mt-6 grid gap-4 md:grid-cols-2">
					<div class="rounded-[18px] bg-warm px-[18px] py-5">
						<h4 class="font-display text-[17px] font-semibold text-amber-ink">Retos</h4>
						<ul class="mt-3 space-y-2.5 text-[13px] leading-5 text-navy">
							{retos.map((r) => <li><strong class="font-bold">{r.b}</strong> {r.t}</li>)}
						</ul>
					</div>
					<div class="rounded-[18px] bg-mist px-[18px] py-5">
						<h4 class="font-display text-[17px] font-semibold text-deep">Oportunidades</h4>
						<ul class="mt-3 space-y-2.5 text-[13px] leading-5 text-navy">
							{oportunidades.map((o) => <li><strong class="font-bold">{o.b}</strong> {o.t}</li>)}
						</ul>
					</div>
				</div>

			<!-- 	<h4 class="mt-8 text-center font-display text-[17px] font-semibold text-navy">Ruta de ascenso propuesta</h4>
				<ol class="mt-4 grid grid-cols-5">
					{ruta.map((r) => (
						<li class="flex flex-col items-center gap-2.5">
							<span class="grid size-[42px] place-items-center rounded-full font-display text-[16px] font-bold" style={`background:${r.bg};color:${r.fg}`}>{r.n}</span>
							<span class="text-[12.5px] font-bold text-navy">{r.label}</span>
						</li>
					))}
				</ol>

				<p class="mt-8 text-center text-[10.5px] text-navy/65">
					Elaboración propia a partir de la revisión (n = 47) y el PDDC 2024-2028. La ruta es una propuesta, no una intervención validada.
				</p> -->
			</div>

			<div class="mt-8 flex flex-wrap justify-center gap-3">
				<a href="#" download class="rounded-full bg-deep px-5 py-3 text-[13px] font-bold text-white hover:brightness-110">Descargar infografía (PDF)</a>
				<button type="button" data-fullscreen-infographic class="rounded-full border border-teal-soft px-5 py-3 text-[13px] font-bold text-navy hover:bg-mist">Ver en tamaño completo</button>
			</div>
		</div>
	</div>
</section>

<script>
	document.querySelector('[data-fullscreen-infographic]')?.addEventListener('click', () => {
		document.getElementById('infografia')?.requestFullscreen?.();
	});
</script>
