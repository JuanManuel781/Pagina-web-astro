---
import { Image } from 'astro:assets';
import logo from '../assets/logo.jpeg';

const stats = [
	{ value: '47', label: 'estudios incluidos' },
	{ value: '6', label: 'bases de datos' },
	{ value: '2020-2026', label: 'periodo analizado' },
];
---

<section class="bg-navy text-white">
	<div class="mx-auto grid max-w-[1200px] items-center gap-12 px-6 py-20 lg:grid-cols-[1.15fr_1fr]">
		<div class="hero-in">
			<span class="inline-block rounded-full bg-teal-soft px-3 py-1.5 text-[12px] font-bold uppercase tracking-[0.12em] text-navy">
				1 · Artículo · Revisión sistemática
			</span>
			<h1 class="mt-6 font-display text-[46px] font-bold leading-[1.12] md:text-[52px]">
				Integración de las TIC, TAC y TEP en entornos educativos rurales de Cundinamarca: revisión sistemática
			</h1>
			<p class="mt-8 max-w-[660px] text-[19px] leading-8 text-white/90">
				Del acceso a las TIC, TAC a su uso pedagógico y a la participación.
			</p>
			<p class="mt-8 text-[15.5px] leading-6 text-white/90">
				Sofía Valeria Martínez Salas · Marlene Ibett Mahecha Zárate · Laura Andrea Molina Álvarez<br />
				Universidad El Bosque · Facultad de Educación
			</p>
			<div class="mt-8 flex flex-wrap gap-4">
				<a href="#introduccion" class="rounded-full bg-amber px-6 py-3.5 text-[16px] font-bold text-navy hover:brightness-105">Iniciar el ascenso</a>
				<!-- <a href="#" class="rounded-full border border-teal-soft px-6 py-3.5 text-[16px] font-bold text-white hover:bg-white/10">Descargar el artículo (PDF)</a> -->
			</div>
			<dl class="mt-12 flex flex-wrap gap-x-8 gap-y-4">
				{stats.map((s) => (
					<div>
						<dt class="font-display text-[38px] font-bold leading-none text-amber">{s.value}</dt>
						<dd class="mt-2 text-[15px] text-white/90">{s.label}</dd>
					</div>
				))}
			</dl>
		</div>
		<div class="hero-in hero-in-delay relative mx-auto w-full max-w-[420px] px-4 py-8">
			<div class="absolute inset-x-0 top-1/2 h-[80%] -translate-y-1/2 rounded-full bg-teal-mid/30 blur-3xl" aria-hidden="true"></div>
			<div class="spin-slow absolute -right-2 top-4 size-36 rounded-full border-2 border-dashed border-amber/70" aria-hidden="true"></div>
			<div class="absolute -left-2 bottom-10 size-20 rounded-full bg-amber/90" aria-hidden="true"></div>

			<div class="float-slow relative">
				<div class="absolute inset-0 translate-x-4 translate-y-4 rounded-t-full rounded-b-[44px] border-2 border-amber" aria-hidden="true"></div>
				<div class="relative aspect-[4/5] overflow-hidden rounded-t-full rounded-b-[44px] border-4 border-white shadow-[0_24px_60px_rgba(0,0,0,0.45)]">
					<Image
						src={logo}
						alt="Mascota de Ascenso en espiral: una comadreja con bata blanca y un espejo dorado en un sendero de montaña"
						width={620}
						loading="eager"
						class="size-full object-cover object-[50%_30%]"
					/>
				</div>

				<span class="float-slower absolute -right-4 top-[22%] rounded-full bg-amber px-4 py-2 font-display text-[14px] font-bold text-navy shadow-lg">TEP</span>
				<span class="float-slow absolute -left-6 top-[50%] rounded-full bg-teal-soft px-4 py-2 font-display text-[14px] font-bold text-navy shadow-lg">TAC</span>
				<span class="float-slower absolute -right-6 bottom-[14%] rounded-full bg-teal-mid px-4 py-2 font-display text-[14px] font-bold text-white shadow-lg">TIC</span>
			</div>
		</div>
	</div>
</section>
