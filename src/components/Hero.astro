---
import Pyramid from './Pyramid.astro';

const stats = [
	{ value: '47', label: 'estudios incluidos' },
	{ value: '6', label: 'bases de datos' },
	{ value: '2020-2026', label: 'periodo analizado' },
];
---
<section class="relative overflow-hidden bg-navy text-white">
	<!-- Fondo decorativo: resplandores, montañas en capas y puntos flotantes. -->
	<div class="pointer-events-none absolute inset-0" aria-hidden="true">
		<div class="absolute -right-32 -top-32 size-[520px] rounded-full bg-teal-mid/25 blur-3xl"></div>
		<div class="absolute -left-40 bottom-0 size-[420px] rounded-full bg-amber/10 blur-3xl"></div>
		<span class="float-slow absolute left-[8%] top-[18%] size-3 rounded-full bg-amber/80"></span>
		<span class="float-slower absolute left-[46%] top-[12%] size-2 rounded-full bg-teal-soft/80"></span>
		<span class="float-slow absolute right-[10%] top-[60%] size-4 rounded-full border-2 border-amber/70"></span>
		<span class="float-slower absolute left-[30%] bottom-[24%] size-2.5 rounded-full bg-teal-soft/60"></span>
		<svg viewBox="0 0 1440 220" preserveAspectRatio="none" class="absolute inset-x-0 bottom-0 h-[150px] w-full md:h-[220px]">
			<path d="M0,170 L160,90 L300,150 L470,40 L640,140 L800,70 L980,150 L1160,60 L1300,120 L1440,80 L1440,220 L0,220 Z" fill="var(--color-teal-deep)" opacity="0.22"></path>
			<path d="M0,200 L200,130 L360,180 L560,100 L720,170 L900,110 L1100,175 L1280,120 L1440,160 L1440,220 L0,220 Z" fill="var(--color-teal-mid)" opacity="0.18"></path>
			<path d="M0,215 L240,170 L460,205 L700,160 L940,205 L1180,165 L1440,200 L1440,220 L0,220 Z" fill="var(--color-night)" opacity="0.55"></path>
		</svg>
	</div>

	<div class="relative mx-auto grid max-w-[1200px] items-center gap-12 px-6 pb-32 pt-20 lg:grid-cols-[1.15fr_1fr]">
		<div class="hero-in">
			<span class="inline-block rounded-full bg-teal-soft px-3 py-1.5 text-[12px] font-bold uppercase tracking-[0.12em] text-navy">
				1 · Artículo · Revisión sistemática
			</span>
			<h1 class="mt-6 font-display text-[46px] font-bold leading-[1.12] md:text-[52px]">
				Integración de las <span class="text-amber">TIC, TAC y TEP</span> en entornos educativos rurales de Cundinamarca: revisión sistemática
			</h1>
			<p class="mt-8 max-w-[660px] text-[19px] leading-8 text-white/90">
				Del acceso a las TIC, TAC a su uso pedagógico y a la participación.
			</p>
			<p class="mt-8 text-[15.5px] leading-6 text-white/90">
				Sofía Valeria Martínez Salas · Marlene Ibett Mahecha Zárate · Laura Andrea Molina Álvarez<br />
				Universidad El Bosque · Facultad de Educación
			</p>
			<div class="mt-8 flex flex-wrap gap-4">
				<a href="#introduccion" class="rounded-full bg-amber px-6 py-3.5 text-[16px] font-bold text-navy hover:brightness-105">Iniciar el ascenso</a>
				<!-- <a href="#" class="rounded-full border border-teal-soft px-6 py-3.5 text-[16px] font-bold text-white hover:bg-white/10">Descargar el artículo (PDF)</a> -->
			</div>
			<dl class="mt-12 flex flex-wrap gap-x-8 gap-y-4">
				{stats.map((s) => (
					<div>
						<dt class="font-display text-[38px] font-bold leading-none text-amber">{s.value}</dt>
						<dd class="mt-2 text-[15px] text-white/90">{s.label}</dd>
					</div>
				))}
			</dl>
		</div>
		<div class="hero-in hero-in-delay flex justify-center">
			<Pyramid />
		</div>
	</div>
	<a href="#introduccion" aria-label="Bajar a la introducción" class="absolute bottom-6 left-1/2 hidden -translate-x-1/2 animate-bounce rounded-full border border-white/40 p-2 text-white/80 hover:text-amber md:block">
		<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
	</a>
</section>
