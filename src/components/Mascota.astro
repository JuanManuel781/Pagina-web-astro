---
import { Image } from 'astro:assets';
import logo from '../assets/logo.jpeg';
---

<a
	href="#"
	data-mascota
	aria-label="Volver al inicio"
	class="mascota group fixed bottom-5 right-5 z-40 translate-y-24 opacity-0 transition duration-500 data-[visible=true]:translate-y-0 data-[visible=true]:opacity-100 md:bottom-8 md:right-8"
>
	<span class="pointer-events-none absolute right-full top-1/2 mr-3 -translate-y-1/2 whitespace-nowrap rounded-full bg-navy px-3.5 py-1.5 text-[13px] font-bold text-white opacity-0 shadow-lg transition group-hover:opacity-100">
		¡Volver arriba!
	</span>
	<span class="mascota-float relative block size-[76px] overflow-hidden rounded-full border-4 border-white bg-mist shadow-[0_8px_24px_rgba(8,53,71,0.35)] ring-2 ring-teal-mid transition group-hover:ring-amber md:size-[88px]">
		<Image
			src={logo}
			alt=""
			width={260}
			class="absolute left-[-58%] top-0 w-[220%] max-w-none"
		/>
	</span>
</a>

<script>
	const mascota = document.querySelector<HTMLElement>('[data-mascota]');

	const update = () => mascota?.setAttribute('data-visible', String(window.scrollY > 500));
	window.addEventListener('scroll', update, { passive: true });
	update();

	mascota?.addEventListener('click', (e) => {
		e.preventDefault();
		window.scrollTo({ top: 0, behavior: 'smooth' });
	});
</script>

<style>
	@media (prefers-reduced-motion: no-preference) {
		.mascota-float {
			animation: flotar 3.2s ease-in-out infinite;
		}
		.mascota:hover .mascota-float {
			animation-play-state: paused;
		}
	}

	@keyframes flotar {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-8px);
		}
	}
</style>
