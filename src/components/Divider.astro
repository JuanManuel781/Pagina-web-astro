---
interface Props {
	/** Color de la sección que termina. */
	from: string;
	/** Color de la sección que empieza. */
	to: string;
}

const { from, to } = Astro.props;
---

<div style={`background:${from}`} aria-hidden="true">
	<svg viewBox="0 0 1440 56" preserveAspectRatio="none" class="block h-10 w-full md:h-14">
		<path d="M0,28 C240,56 480,0 720,28 C960,56 1200,0 1440,28 L1440,56 L0,56 Z" fill={to}></path>
	</svg>
</div>
