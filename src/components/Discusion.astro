---
// Enlace de la presentación en Prezi. Se muestra incrustada, sin salir de la página.
const preziUrl = 'https://prezi.com/craft?load=7YvLuajZcYQtcNtrhcxrzs&referral_token=NP0PoxlnB3FN';

const ideas = [
	{ kicker: 'Hallazgo', text: 'La literatura y el plan se quedan en la base.' },
	{ kicker: 'Tensión', text: 'El plan diagnostica rezago en habilidades digitales, pero sus metas miden cobertura.' },
	{ kicker: 'Implicación', text: 'El reto también es de gobernanza y de enfoque.' },
];
---

<section id="discusion" class="scroll-mt-20 bg-white py-[72px]">
	<div class="reveal mx-auto max-w-[1200px] px-6">
	<!-- 	<div class="flex flex-wrap items-center gap-2.5">
			<span class="rounded-full bg-mist px-3 py-1.5 text-[12px] font-bold uppercase tracking-[0.1em] text-[#0b625f]">
				Estación 4 · Mirador
			</span>
			<span class="rounded-full bg-navy px-3 py-1.5 text-[12px] font-bold text-white">Presentación Prezi</span>
		</div> -->
		<h2 class="mt-3 font-display text-[40px] font-bold leading-tight text-navy">5. Discusión</h2>
		<p class="mt-3 max-w-[760px] text-[18px] leading-8 text-navy/80">
			Desde el mirador, una presentación sobre lo que encontramos al contrastar la literatura con el plan departamental.
		</p>

		<div class="mt-12 space-y-8">
			<div class="rounded-[24px] bg-[#0b625f] p-4 md:p-6">
				<h3 class="font-display text-[23px] font-bold leading-tight text-white">La brecha es conceptual, no solo de dotación</h3>
				<p class="mt-2 text-[12.5px] text-white/90">Presentación interactiva · Usa las flechas para avanzar</p>

				<div class="mt-5 aspect-video overflow-hidden rounded-xl bg-white">
					<iframe
						title="Presentación de la discusión en Prezi"
						src={preziUrl}
						class="size-full border-0"
						allow="fullscreen; autoplay"
						allowfullscreen
						loading="lazy"
					></iframe>
				</div>

				<div class="mt-4 flex items-center justify-end">
					<a href={preziUrl} target="_blank" rel="noopener" class="text-[12.5px] font-semibold text-white underline underline-offset-2">Abrir en Prezi</a>
				</div>
			</div>

			<div>
				<p class="text-[11px] font-bold uppercase tracking-[0.12em] text-[#0b625f]">Ideas clave</p>
				<ul class="mt-4 grid gap-3 md:grid-cols-3">
					{ideas.map((i) => (
						<li class="rounded-2xl border border-[#d3e3e1] bg-white px-4 py-3.5">
							<p class="text-[10.5px] font-bold text-[#a86a00]">{i.kicker}</p>
							<p class="mt-1.5 text-[15px] leading-5 text-navy">{i.text}</p>
						</li>
					))}
				</ul>
			</div>
		</div>
	</div>
</section>
