---
const heights = Array.from({ length: 46 }, (_, i) => {
	const v = Math.abs(Math.sin(i * 0.9) * 0.55 + Math.sin(i * 0.37 + 1) * 0.45);
	return Math.round(14 + v * 48);
});

const ideas = [
	{ kicker: 'Hallazgo', text: 'La literatura y el plan se quedan en la base.' },
	{ kicker: 'Tensión', text: 'El plan diagnostica rezago en habilidades digitales, pero sus metas miden cobertura.' },
	{ kicker: 'Implicación', text: 'El reto también es de gobernanza y de enfoque.' },
];
---

<section id="discusion" class="scroll-mt-20 bg-[#f3f9f8] py-[72px]">
	<div class="mx-auto max-w-[1200px] px-6">
		<div class="flex flex-wrap items-center gap-2.5">
			<span class="rounded-full bg-mist px-3 py-1.5 text-[12px] font-bold uppercase tracking-[0.1em] text-[#0b625f]">
				Estación 4 · Mirador
			</span>
			<span class="rounded-full bg-navy px-3 py-1.5 text-[12px] font-bold text-white">Audio narrativo</span>
		</div>
		<h2 class="mt-3 font-display text-[40px] font-bold leading-tight text-navy">5. Discusión</h2>
		<p class="mt-3 max-w-[760px] text-[18px] leading-8 text-navy/80">
			Desde el mirador, una narración sobre lo que encontramos al contrastar la literatura con el plan departamental.
		</p>

		<div class="mt-12 grid items-start gap-6 lg:grid-cols-[1fr_335px]" data-wave>
			<div class="min-h-[317px] rounded-[24px] bg-[#0b625f] p-6">
				<h3 class="font-display text-[23px] font-bold leading-tight text-white">La brecha es conceptual, no solo de dotación</h3>
				<p class="mt-2 text-[12.5px] text-white/90">Audio narrativo · Duración: <span data-total>[duración]</span></p>

				<audio data-audio preload="none"></audio>

				<div class="mt-7 flex h-[64px] items-center justify-between" aria-hidden="true">
					{heights.map((h, i) => (
						<span data-bar class={`w-[4.5px] rounded-full ${i < 14 ? 'bg-amber' : 'bg-teal-soft'}`} style={`height:${h}px`}></span>
					))}
				</div>

				<div class="mt-7 flex items-center gap-3">
					<button type="button" data-play aria-label="Reproducir" class="grid size-12 shrink-0 place-items-center rounded-full bg-amber text-navy hover:brightness-105">
						<svg data-icon-play width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"></path></svg>
						<svg data-icon-pause class="hidden" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M7 5h4v14H7zM13 5h4v14h-4z"></path></svg>
					</button>
					<span class="text-[12.5px] text-white/90"><span data-time>00:00</span> / <span data-total>[duración]</span></span>
					<a href="#" class="ml-auto text-[12.5px] font-semibold text-white underline underline-offset-2">Leer la transcripción</a>
				</div>
			</div>

			<div>
				<p class="text-[11px] font-bold uppercase tracking-[0.12em] text-[#0b625f]">Ideas clave del audio</p>
				<ul class="mt-4 space-y-3">
					{ideas.map((i) => (
						<li class="rounded-2xl border border-[#d3e3e1] bg-white px-4 py-3.5">
							<p class="text-[10.5px] font-bold text-[#a86a00]">{i.kicker}</p>
							<p class="mt-1.5 text-[15px] leading-5 text-navy">{i.text}</p>
						</li>
					))}
				</ul>
			</div>
		</div>
	</div>
</section>

<script>
	const fmt = (s: number) =>
		`${String(Math.floor(s / 60)).padStart(2, '0')}:${String(Math.floor(s % 60)).padStart(2, '0')}`;

	document.querySelectorAll<HTMLElement>('[data-wave]').forEach((root) => {
		const audio = root.querySelector<HTMLAudioElement>('[data-audio]')!;
		const bars = [...root.querySelectorAll<HTMLElement>('[data-bar]')];
		const time = root.querySelector<HTMLElement>('[data-time]')!;
		const totals = root.querySelectorAll<HTMLElement>('[data-total]');
		const iconPlay = root.querySelector('[data-icon-play]')!;
		const iconPause = root.querySelector('[data-icon-pause]')!;

		root.querySelector('[data-play]')!.addEventListener('click', () => {
			if (!audio.src) return;
			audio.paused ? audio.play() : audio.pause();
		});
		audio.addEventListener('play', () => { iconPlay.classList.add('hidden'); iconPause.classList.remove('hidden'); });
		audio.addEventListener('pause', () => { iconPause.classList.add('hidden'); iconPlay.classList.remove('hidden'); });
		audio.addEventListener('loadedmetadata', () => totals.forEach((t) => (t.textContent = fmt(audio.duration))));
		audio.addEventListener('timeupdate', () => {
			time.textContent = fmt(audio.currentTime);
			const done = Math.round((audio.currentTime / audio.duration) * bars.length) || 0;
			bars.forEach((b, i) => {
				b.classList.toggle('bg-amber', i < done);
				b.classList.toggle('bg-teal-soft', i >= done);
			});
		});
	});
</script>
