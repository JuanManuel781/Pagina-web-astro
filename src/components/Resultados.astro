---
const bars = [
	{ key: 'TEP', value: 7, color: '#a3154f' },
	{ key: 'TAC', value: 15, color: '#e8477f' },
	{ key: 'TIC', value: 20, color: '#f7a6c4' },
];
const max = 20;

// Contenido provisional salvo la parada "Mirador": ajustar con el texto real de la presentación.
const stops = [
	{ tab: 'Vista aérea', label: 'Bibliometría', kicker: 'Vista aérea', title: 'El mapa de la producción científica', text: 'Estudios por altura de la tríada (n = 47).', focus: ['TEP', 'TAC', 'TIC'] },
	{ tab: 'Base · TIC', label: '20 estudios', kicker: 'Base · TIC', title: 'La base: acceso y conectividad', text: '20 de los 47 estudios se concentran en la altura TIC.', focus: ['TIC'] },
	{ tab: 'Ladera · TAC', label: '15 estudios', kicker: 'Ladera · TAC', title: 'La ladera: uso pedagógico', text: '15 de los 47 estudios abordan las TAC.', focus: ['TAC'] },
	{ tab: 'Senderos alternos', label: '5 estudios', kicker: 'Senderos alternos', title: 'Senderos alternos: móvil y offline', text: 'Estudios sobre soluciones móviles y sin conexión.', focus: ['TEP', 'TAC', 'TIC'] },
	{ tab: 'Cumbre · TEP', label: '7 estudios', kicker: 'Cumbre · TEP', title: 'La cumbre: participación', text: 'Solo 7 de los 47 estudios llegan a la altura TEP.', focus: ['TEP'] },
	{ tab: 'Mirador · PDDC', label: 'Contraste', kicker: 'Mirador', title: 'La literatura y el plan se quedan en la base', text: 'Estudios por altura de la tríada (n = 47).', focus: ['TEP', 'TAC', 'TIC'] },
];
---

<section id="resultados" class="scroll-mt-20 bg-white py-[60px]" data-stops>
	<div class="mx-auto max-w-[900px] px-6 lg:max-w-[1200px]">
		<div class="mx-auto lg:mx-0 lg:max-w-[900px]">
			<div class="flex flex-wrap items-center gap-2.5">
				<span class="rounded-full bg-mist px-3 py-1.5 text-[12px] font-bold uppercase tracking-[0.1em] text-[#a3154f]">
					Estación 3 · El ascenso
				</span>
				<span class="rounded-full bg-navy px-3 py-1.5 text-[12px] font-bold text-white">Presentación Prezi</span>
			</div>
			<h2 class="mt-3 font-display text-[40px] font-bold leading-tight text-navy">4. Análisis de resultados</h2>
			<p class="mt-3 max-w-[760px] text-[18px] leading-8 text-navy/80">
				Sube de la base a la cumbre con la presentación interactiva: cada parada amplía una altura de la tríada.
			</p>
		</div>

		<div class="mt-12 overflow-hidden rounded-[28px] border border-[#f3d9df]">
			<div class="flex items-center justify-between border-b border-[#f3d9df] px-4 py-3.5 text-[12.5px]">
				<strong class="font-bold text-navy">Prezi · Análisis de resultados</strong>
				<span class="text-navy/60">Parada <span data-current>1</span> de {stops.length}</span>
			</div>

			<div class="bg-[#fff6f2] px-4 py-6 md:px-20">
				<div class="rounded-[18px] bg-white shadow-[0_6px_24px_rgba(8,53,71,0.10)]">
					{stops.map((s, i) => (
						<article data-slide class={`min-h-[413px] items-center gap-10 px-8 py-10 md:grid-cols-2 ${i === 0 ? 'grid' : 'hidden'}`}>
							<div>
								<p class="text-[10.5px] font-bold uppercase tracking-[0.14em] text-[#b04a1a]">{s.kicker}</p>
								<h3 class="mt-3 font-display text-[28px] font-bold leading-tight text-navy">{s.title}</h3>
								<p class="mt-3 text-[14px] text-navy/80">{s.text}</p>
							</div>
							<div>
								<div class="space-y-2.5">
									{bars.map((b) => (
										<div class={`flex items-center gap-3 text-[11px] font-bold text-navy transition-opacity ${s.focus.includes(b.key) ? '' : 'opacity-30'}`}>
											<span class="w-9">{b.key}</span>
											<div class="h-[22px] flex-1 overflow-hidden rounded bg-[#fbeee9]">
												<div class="h-full rounded" style={`width:${(b.value / max) * 100}%;background:${b.color}`}></div>
											</div>
											<span class="w-5">{b.value}</span>
										</div>
									))}
								</div>
								<p class="mt-3 text-[11px] text-navy/65">Además, 5 estudios sobre senderos alternos (móvil y offline).</p>
							</div>
						</article>
					))}
				</div>

				<div class="mt-6 flex items-center justify-center gap-4 text-[12.5px] font-semibold text-[#a3154f]">
					<button type="button" data-prev aria-label="Parada anterior" class="grid size-9 place-items-center rounded-full border border-teal-soft bg-white text-[#a3154f] hover:bg-mist">
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m15 5-7 7 7 7"></path></svg>
					</button>
					<button type="button" data-next aria-label="Parada siguiente" class="grid size-9 place-items-center rounded-full bg-[#a3154f] text-white hover:brightness-110">
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m9 5 7 7-7 7"></path></svg>
					</button>
					<button type="button" data-fullscreen class="ml-3 underline underline-offset-2">Pantalla completa</button>
					<a href="#" target="_blank" rel="noopener" class="ml-3 underline underline-offset-2">Abrir en Prezi</a>
				</div>
			</div>
		</div>

		<ul class="mt-8 grid grid-cols-2 gap-3 md:grid-cols-3 lg:grid-cols-6">
			{stops.map((s, i) => (
				<li>
					<button
						type="button"
						data-tab={i}
						class="h-full w-full rounded-xl border border-[#f3d9df] bg-white px-3.5 py-3 text-left data-[active=true]:border-amber data-[active=true]:bg-[#fff0e0]"
					>
						<span class="block text-[11px] font-bold text-navy/80">{s.tab}</span>
						<span class="mt-1.5 block font-display text-[16px] font-semibold text-navy">{s.label}</span>
					</button>
				</li>
			))}
		</ul>
	</div>
</section>

<script>
	document.querySelectorAll<HTMLElement>('[data-stops]').forEach((root) => {
		const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
		const tabs = [...root.querySelectorAll<HTMLElement>('[data-tab]')];
		const current = root.querySelector<HTMLElement>('[data-current]')!;
		let index = 0;

		const show = (i: number) => {
			index = (i + slides.length) % slides.length;
			slides.forEach((s, n) => {
				s.classList.toggle('hidden', n !== index);
				s.classList.toggle('grid', n === index);
			});
			tabs.forEach((t, n) => t.setAttribute('data-active', String(n === index)));
			current.textContent = String(index + 1);
		};

		tabs.forEach((t, n) => t.addEventListener('click', () => show(n)));
		root.querySelector('[data-prev]')!.addEventListener('click', () => show(index - 1));
		root.querySelector('[data-next]')!.addEventListener('click', () => show(index + 1));
		root.querySelector('[data-fullscreen]')!.addEventListener('click', () => {
			slides[index].parentElement?.requestFullscreen?.();
		});
		show(0);
	});
</script>
