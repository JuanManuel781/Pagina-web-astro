---
const points = [
	{ n: 1, x: 87, y: 324 },
	{ n: 2, x: 360, y: 292 },
	{ n: 3, x: 126, y: 216 },
	{ n: 4, x: 316, y: 177 },
	{ n: 5, x: 199, y: 105 },
	{ n: 6, x: 233, y: 32 },
];
const path = points.map((p) => `${p.x},${p.y}`).join(' ');
---

<svg viewBox="-4 -4 474 358" class="w-full max-w-[470px]" role="img" aria-label="Pirámide TIC, TAC y TEP con ascenso en espiral de seis pasos">
	<polygon points="233,0 310,116 156,116" fill="#fde7ef"></polygon>
	<polygon points="156,116 310,116 388,233 78,233" fill="#f7a6c4"></polygon>
	<polygon points="78,233 388,233 466,350 0,350" fill="#e8477f"></polygon>
	<polyline points={path} fill="none" stroke="#ffa06b" stroke-width="2.5" stroke-dasharray="7 6"></polyline>
	<g font-family="Space Grotesk, sans-serif" font-weight="700" fill="#4a1942">
		<text x="257" y="104" font-size="15">TEP</text>
		<text x="331" y="221" font-size="17">TAC</text>
		<text x="406" y="337" font-size="17">TIC</text>
	</g>
	{points.map((p) => (
		<g>
			<circle cx={p.x} cy={p.y} r="14" fill={p.n === 6 ? '#ffa06b' : '#4a1942'} stroke="#ffa06b" stroke-width="3"></circle>
			<text x={p.x} y={p.y + 4} text-anchor="middle" font-size="11" font-weight="700" font-family="Space Grotesk, sans-serif" fill={p.n === 6 ? '#4a1942' : '#fff'}>{p.n}</text>
		</g>
	))}
</svg>
