---
const links = [
	{ href: '#introduccion', label: 'Introducción' },
	{ href: '#metodologia', label: 'Metodología' },
	{ href: '#resultados', label: 'Resultados' },
	{ href: '#discusion', label: 'Discusión' },
	{ href: '#conclusiones', label: 'Conclusiones' },
	{ href: '#referencias', label: 'Referencias' },
];
---

<header class="sticky top-0 z-50 bg-white">
	<div class="mx-auto flex h-[74px] max-w-[1200px] items-center justify-between gap-6 px-6">
		<a href="#" class="flex items-center gap-3">
			<svg width="34" height="30" viewBox="0 0 34 30" aria-hidden="true">
				<polygon points="17,0 34,30 0,30" fill="#4aa5a0"></polygon>
				<polygon points="17,0 24,12 10,12" fill="#083547"></polygon>
				<polygon points="10,12 24,12 29,21 5,21" fill="#2f7f84"></polygon>
			</svg>
			<span class="leading-tight">
				<span class="block font-display text-[19px] font-semibold text-navy">Ascenso en espiral</span>
				<span class="block text-[12.5px] text-navy/70">
					Recurso digital · Maestría en Innovación y Tecnologías para la Educación
				</span>
			</span>
		</a>
		<nav class="hidden items-center gap-7 text-[14.5px] font-semibold text-navy lg:flex">
			{links.map((l) => <a href={l.href} class="hover:text-teal-mid">{l.label}</a>)}
		</nav>
	</div>
</header>
