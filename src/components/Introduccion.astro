---
const chapters = [
	{ n: '01', title: 'Las tres alturas: TIC, TAC y TEP' },
	{ n: '02', title: 'Antecedentes y brecha digital rural' },
	{ n: '03', title: 'Marco teórico y conceptual' },
	{ n: '04', title: 'Problema, vacío y pregunta' },
];
---

<section id="introduccion" class="scroll-mt-20 bg-white py-[88px]">
	<div class="mx-auto max-w-[1200px] px-6">
		<div class="flex flex-wrap items-center gap-2.5">
			<span class="rounded-full bg-mist px-3 py-1.5 text-[12px] font-bold uppercase tracking-[0.1em] text-[#a3154f]">
				Estación 1 · Campamento base
			</span>
			<span class="rounded-full bg-navy px-3 py-1.5 text-[12px] font-bold text-white">Podcast</span>
		</div>
		<h2 class="mt-3 font-display text-[40px] font-bold leading-tight text-navy">2. Introducción</h2>
		<p class="mt-3 max-w-[760px] text-[18px] leading-8 text-navy/80">
			Escuche el punto de partida del ascenso: qué son las TIC, TAC y TEP, qué dicen los antecedentes y cuál es el marco que orienta la revisión.
		</p>

		<div class="mt-12 grid gap-8 rounded-[28px] bg-[#fff4f0] p-8 md:grid-cols-[300px_1fr]">
			<div class="relative flex min-h-[340px] flex-col justify-between rounded-[20px] bg-[#a3154f] p-6">
				<span class="text-[11.5px] font-bold uppercase tracking-[0.14em] text-teal-soft">Podcast · Episodio 1</span>
				<svg viewBox="0 0 230 112" class="mx-auto w-[230px]" aria-hidden="true">
					<polygon points="115,0 153,42 77,42" fill="#fde7ef"></polygon>
					<polygon points="77,42 153,42 230,112 0,112" fill="#e8477f"></polygon>
					<rect x="98" y="52" width="34" height="46" rx="17" fill="#4a1942"></rect>
					<rect x="109" y="96" width="12" height="10" fill="#4a1942"></rect>
				</svg>
				<p class="font-display text-[25px] font-bold leading-tight text-white">Del acceso a la comunidad</p>
			</div>

			<div class="min-w-0" data-player>
				<h3 class="font-display text-[26px] font-bold leading-snug text-navy">
					Episodio 1: Conceptos, antecedentes y marco de la revisión
				</h3>
				<p class="mt-2 text-[15px] text-navy/70">Narran: Sofía, Marlene y Laura · Duración: [duración]</p>

				<audio data-audio preload="none"></audio>

				<div class="mt-6 flex items-center gap-4">
					<button type="button" data-back aria-label="Retroceder 10 segundos" class="grid size-12 shrink-0 place-items-center rounded-full border-2 border-teal-soft text-navy hover:bg-white">
						<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7"></path><path d="M3 4v5h5"></path></svg>
					</button>
					<button type="button" data-play aria-label="Reproducir" class="grid size-16 shrink-0 place-items-center rounded-full bg-amber text-navy hover:brightness-110">
						<svg data-icon-play width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"></path></svg>
						<svg data-icon-pause class="hidden" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M7 5h4v14H7zM13 5h4v14h-4z"></path></svg>
					</button>
					<button type="button" data-fwd aria-label="Adelantar 10 segundos" class="grid size-12 shrink-0 place-items-center rounded-full border-2 border-teal-soft text-navy hover:bg-white">
						<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-3-6.7"></path><path d="M21 4v5h-5"></path></svg>
					</button>
					<div class="min-w-0 flex-1">
						<div class="h-2 overflow-hidden rounded-full bg-[#f3d9df]">
							<div data-bar class="h-full w-[18%] rounded-full bg-[#a3154f]"></div>
						</div>
						<div class="mt-2 flex justify-between text-[12.5px] text-navy/70">
							<span data-time>00:00</span>
							<span data-total>[duración]</span>
						</div>
					</div>
				</div>

				<p class="mt-8 text-[12.5px] font-bold uppercase tracking-[0.12em] text-[#a3154f]">Capítulos</p>
				<ul class="mt-3 grid gap-3 md:grid-cols-2">
					{chapters.map((c) => (
						<li class="rounded-xl border border-[#f3d9df] bg-white px-4 py-3.5 text-[15px] text-navy">
							<strong class="font-bold text-[#a3154f]">{c.n}</strong> · {c.title}
						</li>
					))}
				</ul>

				<div class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-[15px] font-semibold text-[#a3154f] underline underline-offset-2">
					<a href="#">Leer la transcripción</a>
					<a href="#">Descargar MP3</a>
					<a href="#">Escuchar en [plataforma de podcast]</a>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	const fmt = (s: number) =>
		`${String(Math.floor(s / 60)).padStart(2, '0')}:${String(Math.floor(s % 60)).padStart(2, '0')}`;

	document.querySelectorAll<HTMLElement>('[data-player]').forEach((root) => {
		const audio = root.querySelector<HTMLAudioElement>('[data-audio]')!;
		const bar = root.querySelector<HTMLElement>('[data-bar]')!;
		const time = root.querySelector<HTMLElement>('[data-time]')!;
		const total = root.querySelector<HTMLElement>('[data-total]')!;
		const iconPlay = root.querySelector('[data-icon-play]')!;
		const iconPause = root.querySelector('[data-icon-pause]')!;

		root.querySelector('[data-play]')!.addEventListener('click', () => {
			if (!audio.src) return;
			audio.paused ? audio.play() : audio.pause();
		});
		root.querySelector('[data-back]')!.addEventListener('click', () => (audio.currentTime -= 10));
		root.querySelector('[data-fwd]')!.addEventListener('click', () => (audio.currentTime += 10));

		audio.addEventListener('play', () => { iconPlay.classList.add('hidden'); iconPause.classList.remove('hidden'); });
		audio.addEventListener('pause', () => { iconPause.classList.add('hidden'); iconPlay.classList.remove('hidden'); });
		audio.addEventListener('loadedmetadata', () => (total.textContent = fmt(audio.duration)));
		audio.addEventListener('timeupdate', () => {
			time.textContent = fmt(audio.currentTime);
			bar.style.width = `${(audio.currentTime / audio.duration) * 100 || 0}%`;
		});
	});
</script>
