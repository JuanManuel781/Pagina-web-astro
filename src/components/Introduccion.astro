---
// Pega aquí el enlace del episodio en Spotify (Compartir → Copiar enlace del episodio).
const spotifyUrl = "https://open.spotify.com/episode/6si5684UGhd1Nh70LlNGUc";
const spotifyEmbed = spotifyUrl.replace("open.spotify.com/", "open.spotify.com/embed/").split("?")[0];

// La duración se lee de Spotify al compilar el sitio; si falla, se omite.
let duration = '';
try {
	const html = await (await fetch(spotifyEmbed)).text();
	const ms = Number(html.match(/"duration":(\d+)/)?.[1]);
	if (ms) {
		const min = Math.floor(ms / 60000);
		const sec = String(Math.round((ms % 60000) / 1000)).padStart(2, '0');
		duration = `${min}:${sec} min`;
	}
} catch {}

const chapters = [
	{ n: '01', title: 'Las tres alturas: TIC, TAC y TEP' },
	{ n: '02', title: 'Antecedentes y brecha digital rural' },
	{ n: '03', title: 'Marco teórico y conceptual' },
	{ n: '04', title: 'Problema, vacío y pregunta' },
];
---

<section id="introduccion" class="scroll-mt-20 bg-white py-[88px]">
	<div class="reveal mx-auto max-w-[1200px] px-6">
		<!-- <div class="flex flex-wrap items-center gap-2.5">
			<span class="rounded-full bg-mist px-3 py-1.5 text-[12px] font-bold uppercase tracking-[0.1em] text-deep">
				Estación 1 · Campamento base
			</span>
			<span class="rounded-full bg-navy px-3 py-1.5 text-[12px] font-bold text-white">Podcast</span>
		</div> -->
		<h2 class="mt-3 font-display text-[40px] font-bold leading-tight text-navy">2. Introducción</h2>
		<span class="mt-4 block h-1.5 w-20 rounded-full bg-gradient-to-r from-amber to-teal-mid" aria-hidden="true"></span>
		<p class="mt-3 max-w-[760px] text-[18px] leading-8 text-navy/80">
			Escuche el punto de partida: qué son las TIC, TAC y TEP, qué dicen los antecedentes y cuál es el marco que orienta la revisión.
		</p>

		<div class="mt-12 grid gap-8 rounded-[28px] bg-tint p-8 md:grid-cols-[300px_1fr]">
			<div class="relative flex min-h-[340px] flex-col justify-between rounded-[20px] bg-deep p-6">
				<span class="text-[11.5px] font-bold uppercase tracking-[0.14em] text-teal-soft">Podcast · Episodio 1</span>
				<svg viewBox="0 0 230 112" class="mx-auto w-[230px]" aria-hidden="true">
					<polygon points="115,0 153,42 77,42" fill="var(--color-mist)"></polygon>
					<polygon points="77,42 153,42 230,112 0,112" fill="var(--color-teal-mid)"></polygon>
					<rect x="98" y="52" width="34" height="46" rx="17" fill="var(--color-navy)"></rect>
					<rect x="109" y="96" width="12" height="10" fill="var(--color-navy)"></rect>
				</svg>
				<p class="font-display text-[25px] font-bold leading-tight text-white">Del acceso a la comunidad</p>
			</div>

			<div class="min-w-0" data-player>
				<h3 class="font-display text-[26px] font-bold leading-snug text-navy">
					Episodio 1: Conceptos, antecedentes y marco de la revisión
				</h3>
				<p class="mt-2 text-[15px] text-navy/70">Narran: Sofía, Marlene y Laura{duration && ` · Duración: ${duration}`}</p>


				{spotifyUrl ? (
					<iframe
						title="Episodio 1 en Spotify"
						src={spotifyEmbed}
						width="100%"
						height="152"
						class="mt-6 rounded-xl border-0"
						allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
						loading="lazy"
					></iframe>
				) : (
					<p class="mt-6 rounded-xl border border-dashed border-teal-soft bg-white px-4 py-6 text-center text-[14px] text-navy/70">
						Aquí irá el reproductor de Spotify. Pega el enlace en <code>spotifyUrl</code> de Introduccion.astro.
					</p>
				)}

				<p class="mt-8 text-[12.5px] font-bold uppercase tracking-[0.12em] text-deep">Capítulos</p>
				<ul class="mt-3 grid gap-3 md:grid-cols-2">
					{chapters.map((c) => (
						<li class="rounded-xl border border-line bg-white px-4 py-3.5 text-[15px] text-navy transition hover:-translate-y-0.5 hover:border-teal-mid hover:shadow-md">
							<strong class="font-bold text-deep">{c.n}</strong> · {c.title}
						</li>
					))}
				</ul>

				<div class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-[15px] font-semibold text-deep underline underline-offset-2">
					<a href="#">Leer la transcripción</a>
					
					<a href={spotifyUrl || "#"} target="_blank" rel="noopener">Escuchar en Spotify</a>
				</div>
			</div>
		</div>
	</div>
</section>
