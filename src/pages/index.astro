---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Divider from '../components/Divider.astro';
import Introduccion from "../components/Introduccion.astro";
import Metodologia from "../components/Metodologia.astro";
import Resultados from "../components/Resultados.astro";
import Discusion from "../components/Discusion.astro";
import Conclusiones from "../components/Conclusiones.astro";
import Referencias from "../components/Referencias.astro";
import Footer from "../components/Footer.astro";

const blanco = '#ffffff';
const verde = 'var(--color-tint)';
const oscuro = 'var(--color-navy)';
---

<Layout title="Ascenso en espiral · Integración de las TIC, TAC y TEP">
	<Header />
	<main>
		<Hero />
		<Divider from={oscuro} to={blanco} />
		<Introduccion />
		<Divider from={blanco} to={verde} />
		<Metodologia />
		<!-- <Resultados /> -->
		<Divider from={verde} to={blanco} />
		<Discusion />
		<Divider from={blanco} to={verde} />
		<Conclusiones />
		<Divider from={verde} to={blanco} />
		<Referencias />
	</main>
	<Divider from={blanco} to={oscuro} />
	<Footer />
</Layout>
